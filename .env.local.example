# Copie para .env.local e preencha conforme o ambiente.

# ── Acesso ao painel (/admin) ────────────────────────────
# Sem AUTH_SECRET o painel abre direto em desenvolvimento e fica indisponivel
# em producao. Gere um valor longo e aleatorio, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Primeiro acesso: valem apenas enquanto nenhum acesso tiver sido cadastrado.
# Depois do primeiro login, os demais sao cadastrados dentro do painel.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Armazenamento em producao (Vercel Blob) ──────────────
# Nao precisa preencher na mao: ao conectar cada store ao projeto na Vercel,
# use os prefixos abaixo e ela mesma cria as variaveis.
#
#   store PRIVADA (content.json e users.json) -> prefixo BLOB_CONTENT
#   store PUBLICA (imagens, GIFs e videos)    -> prefixo BLOB_MEDIA
#
# Isso gera BLOB_CONTENT_READ_WRITE_TOKEN e BLOB_MEDIA_READ_WRITE_TOKEN, que e
# o que o projeto le. Sem as duas, o site usa local-content/ e public/uploads.
BLOB_CONTENT_READ_WRITE_TOKEN=
BLOB_MEDIA_READ_WRITE_TOKEN=
