# Copie para .env.local e preencha conforme o ambiente.

# ── Acesso ao painel (/admin) ────────────────────────────
# Sem AUTH_SECRET o painel abre direto em desenvolvimento e fica indisponivel
# em producao. Gere um valor longo e aleatorio, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Primeiro acesso: valem apenas enquanto nenhum acesso tiver sido cadastrado.
# Depois do primeiro login, os demais sao cadastrados dentro do painel.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Armazenamento em producao (Vercel Blob) ──────────────
# Sem os dois tokens, o site usa local-content/ e public/uploads no disco.
# BLOB_CONTENT_TOKEN: store PRIVADA, guarda content.json e users.json
# BLOB_MEDIA_TOKEN:   store PUBLICA, guarda imagens, GIFs e videos
BLOB_CONTENT_TOKEN=
BLOB_MEDIA_TOKEN=
